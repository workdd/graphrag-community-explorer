# Copy to .env.development.local (ignored by Git, read by `npm run dev` only) to open a local
# folder on start. Put the files in local-data/<name>/: entities.parquet, relationships.parquet,
# communities.parquet, community_reports.parquet, optionally text_units.parquet, documents.parquet
# and <label>_communities.parquet listed in manifest.json.
VITE_DEFAULT_DATA=./data/my-index

# Ask tab defaults. Set these to skip typing the provider settings on every browser. Anything typed
# in the app is kept in that browser and wins over these values.
#
# Vite inlines VITE_* into the bundle. A key set here is readable by anyone who can read the built
# files, so `npm run build` refuses to publish one unless ALLOW_EMBEDDED_KEY=1 is set. Leave the key
# out for anything you deploy.
VITE_LLM_BASE_URL=https://api.upstage.ai/v1
VITE_LLM_CHAT_MODEL=solar-pro2
VITE_LLM_EMBED_MODEL=solar-embedding-1-large-query
VITE_LLM_API_KEY=

# Apache AGE export (tools/export_age_parquet.py); copy to .env.age, never commit
AGE_HOST=
AGE_PORT=5432
AGE_DB=graphrag
AGE_USER=
AGE_PASSWORD=
AGE_GRAPH=
